# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env
.env.local
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code agent worktrees (runtime workspaces, never content)
.claude/worktrees/

# Playwright (E2E) artifacts
/test-results/
/playwright-report/
/blob-report/
/e2e/.auth/
# The CI json reporter's output (see playwright.config.ts) — read by
# scripts/e2e-flaky-summary.mjs and uploaded with the report, never committed.
/e2e-results.json

# scripts/night-band-grade.mjs writes its screenshots + contrast report here.
# Evidence for a PR or an issue, never a repo artifact — the measurement that
# matters lives in BRAND.md Part 7, and the script regenerates the rest.
/.shots/
